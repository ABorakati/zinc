<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test harness: drives an INVISIBLE, private Word instance through the add-in's own document code (WordDoc/Bridge)
       and exposes the sidebar's RPC over stdin/stdout so the real sidebar controller (TypeScript) can run against it. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ZoteroNextWord.Harness</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\harness\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="..\addin\ZoteroNextWord.csproj" />
  </ItemGroup>
</Project>
