<?xml version="1.0" encoding="UTF-8"?>
<!-- vnd.zinc.lo:<command> URLs (the Zinc menu and toolbar, Addons.xcu) go to zinc.py's Commands. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="ProtocolHandler" oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="dev.zinc.libreoffice.Commands" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>vnd.zinc.lo:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
