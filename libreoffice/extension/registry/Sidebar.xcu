<?xml version="1.0" encoding="UTF-8"?>
<!-- The "Zinc" deck in Writer's sidebar, with one panel that fills it (zinc.py PanelFactory). WantsAWT: the panel is built
     from toolkit (AWT) windows, which the sidebar only hands to panels that ask for them. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="ZincDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Zinc</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>ZincDeck</value>
        </prop>
        <prop oor:name="IconURL" oor:type="xs:string">
          <value>%origin%/../icons/zinc-24.png</value>
        </prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">WriterVariants, any, visible ;</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>1000</value>
        </prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="ZincPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Zinc</value>
        </prop>
        <prop oor:name="TitleBarIsOptional" oor:type="xs:boolean">
          <value>true</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>ZincPanel</value>
        </prop>
        <prop oor:name="DeckId" oor:type="xs:string">
          <value>ZincDeck</value>
        </prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">WriterVariants, any, visible ;</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/ZincPanelFactory/ZincPanel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>100</value>
        </prop>
        <prop oor:name="WantsAWT" oor:type="xs:boolean">
          <value>true</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
