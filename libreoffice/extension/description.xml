    <name lang="en">Zinc citations</name>
  </display-name>
  <publisher>
    <name xlink:href="https://github.com/ABorakati/zinc" lang="en">Zinc</name>
  </publisher>
  <icon>
    <default xlink:href="icons/zinc-42.png"/>
  </icon>
  <extension-description>
    <src xlink:href="description/en.txt" lang="en"/>
  </extension-description>
</description>
