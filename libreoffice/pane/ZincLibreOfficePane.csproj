<Project Sdk="Microsoft.NET.Sdk">
  <!-- The LibreOffice sidebar's pane process (Windows): a WebView2 showing the shared sidebar bundle (word/sidebar), created
       as a child window of the LibreOffice sidebar panel's native window. lib.* / style.* / settings.* are answered with the
       Word add-in's own code (ProjectReference); doc.* goes to the extension inside LibreOffice over stdin/stdout. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ZincLibreOfficePane</AssemblyName>
    <RootNamespace>Zinc.LibreOffice</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\pane\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="..\..\word\addin\ZoteroNextWord.csproj" />
  </ItemGroup>
</Project>
