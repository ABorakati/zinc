---
import Icon from "../components/Icon.astro";
import Plate from "../components/Plate.astro";
import Race from "../components/Race.astro";
import Shelf from "../components/Shelf.astro";
import Site from "../layouts/Site.astro";
import { bullets, inline, paragraphs, section } from "../lib/readme";
import { volumes } from "../lib/shelf";

const base = import.meta.env.BASE_URL;
const vols = volumes(base);

// "Works with the app closed": each README bullet starts with its title in bold; the Word add-in's own README section adds the sidebar.
const closed = bullets(section("### Works with the app closed")).map((b) => {
	const m = /^\*\*(.+?)\*\*\s*(.*)$/.exec(b);
	return { title: m ? m[1].replace(/\.$/, "") : "", body: m ? m[2] : b };
});
const word = paragraphs(section("## The Word add-in"))[0];
const items = [
	{ icon: "panel-right", title: "Cite in Word, from a sidebar", lead: true, body: [word, closed[1]?.body ?? ""], tags: ["Word for Windows", "Live citations", "Any CSL style", "App can stay closed"] },
	{ icon: "globe", title: "Save from Chrome and Edge", body: [closed[0]?.body ?? ""], tags: ["Pages, PDFs, references", "App can stay closed"] },
	{ icon: "bot", title: "Hand it to an agent", body: [closed[2]?.body ?? "", paragraphs(section("### Built-in MCP for AI agents"))[0]], tags: ["MCP", "Claude Code", "Loopback only"] },
];
const still = paragraphs(section("### Still your Zotero library"));
---
<Site page="home">
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<h1 class="display">Your Zotero library. <span class="accent">Fast, modern, AI&nbsp;native.</span></h1>
				<p class="lede">Opens in half a second and searches 12,000 items in milliseconds. Save from your browser and cite from a sidebar in Word, even with the app closed, and let AI agents work with your library.</p>
				<div class="actions">
					<a class="btn btn-primary btn-lg" href={`${base}download/`}><Icon name="download" />Download for Windows</a>
					<a class="btn btn-outline btn-lg" href={`${base}features/`}><Icon name="library" />See the features</a>
				</div>
				<p class="fine"><span class="mono">0.1.0</span> · Windows 10 and 11, 64-bit · per-user install, no admin rights</p>
			</div>
			<Plate n="I" src="library-cards-light.png" dark="library-cards-dark.png" tilt={-1.2} eager
				alt="The library in Cards view: coloured collections on the left, papers grouped by year in the middle, the selected paper's details on the right"
				caption="The library in Cards view, with coloured and pinned collections, grouped by year." />
		</div>
	</section>

	<section class="room-tight" style="padding-bottom: clamp(4rem, 8vw, 6.5rem)">
		<div class="wrap volume" style="align-items: center">
			<div class="prose">
				<h2 class="h2" style="margin-bottom: 1.1rem">Feel the difference</h2>
				<p>The same 12,400-item library in Zotero 10 and Zotero Next, raced in real time. Zotero Next has your library ready before Zotero 10 has drawn it, and answers a search before you lift your finger.</p>
			</div>
			<Race />
		</div>
	</section>

	<section class="room room-alt">
		<div class="wrap closed">
			<div class="closed-head">
				<h2 class="h2">Works with the app closed</h2>
				<p>The Word add-in, the browser connector and the agent server each open your library file themselves. Cite, save and ask without starting Zotero Next.</p>
			</div>
			<div class="closed-list">
				{items.map((it) => (
					<article class:list={["closed-item", { lead: it.lead }]}>
						<h3><Icon name={it.icon} size={24} />{it.title}</h3>
						{it.body.filter(Boolean).map((p) => <p set:html={inline(p, base)} />)}
						<div class="closed-tags">{it.tags.map((t) => <span>{t}</span>)}</div>
					</article>
				))}
			</div>
			<div class="closed-plate">
				<Plate n="VII" src="word-sidebar.png" h={839} tilt={0.5} alt="Word with the Zotero Next sidebar open beside a paragraph with six numbered citations and a Vancouver bibliography; the sidebar shows the citation under the cursor" caption="The Word sidebar showing the citation under the cursor, with the app closed." />
			</div>
		</div>
	</section>

	<section class="cloth shelf-room">
		<div class="wrap">
			<div class="head">
				<h2 class="h2">The whole collection, bound in one app</h2>
				<p>Library, reader, notes, sync, translators, citation keys, the Word add-in and an agent server. Take a volume off the shelf.</p>
			</div>
			<Shelf />
		</div>
	</section>

	<section class="room">
		<div class="wrap">
			<article class="volume">
				<div>
					<h2 class="h2">Cards when you browse, a table when you sort</h2>
					<div class="prose"><p>The window is drawn on the GPU by Zed's GPUI, not inside a web page, so it opens fast and scrolls at your display's rate.</p></div>
					<ul class="points">
						<li>Cards with authors, venue, tags and one-click actions, or a sortable Classic table</li>
						<li>Collections with colours, icons, pins and your own sections</li>
						<li>Grouping, multi-level sorting, saved searches, duplicate merging</li>
						<li>Drop files on the window, or paste an identifier into the list</li>
					</ul>
				</div>
				<Plate n="II" src="classic-table-dark.png" tilt={0.8} vol={vols[0]} alt="The Classic table, grouped by year, in the dark theme" caption="The Classic table, grouped by year, dark theme." />
			</article>

			<article class="volume flip">
				<div>
					<h2 class="h2">A reader that keeps your marks</h2>
					<div class="prose"><p>Pages are rendered by PDFium through a small Rust library. Annotations live in the library, so they sync like everything else.</p></div>
					<ul class="points">
						<li>Highlight, underline, note, ink, image and eraser, with colours, tags and comments</li>
						<li>Thumbnails, outline, search, spreads, rotation, dark and sepia page tints</li>
						<li>Click an in-text citation to see the reference and add it to your library</li>
					</ul>
				</div>
				<Plate n="III" src="pdf-reader-annotations-light.png" dark="pdf-reader-annotations-dark.png" h={881} tilt={-0.9} vol={vols[1]} alt="The PDF reader with highlights and the annotations panel" caption="The PDF reader with the annotations panel." />
			</article>

			<article class="volume">
				<div>
					<h2 class="h2">Read the paper, not the page layout</h2>
					<div class="prose"><p>The reading view reflows an article into one column in your own font, size and width. Figures and tables become cards you can open, and every reference is one click away.</p></div>
				</div>
				<Plate n="IV" src="reading-view-table.png" tilt={0.6} vol={vols[1]} alt="The reading view, showing an article's table as a card" caption="The reading view, with a table set as a card." />
			</article>
		</div>
	</section>

	<section class="room room-alt">
		<div class="wrap slip-wrap">
			<div>
				<h2 class="h2" style="margin-bottom: 1.1rem">Still your Zotero library</h2>
				<div class="prose" style="margin-bottom: 2rem">{still.map((p) => <p set:html={inline(p, base)} />)}</div>
				<div class="actions">
					<a class="btn btn-primary btn-lg" href={`${base}download/`}><Icon name="download" />Download for Windows</a>
					<a class="btn btn-outline btn-lg" href={`${base}user-guide/first-run/`}><Icon name="book-open" />How first run works</a>
				</div>
			</div>
			<div class="slip" data-reveal>
				<h3>Date due</h3>
				<table>
					<tbody>
						<tr style="--r:0"><td>Zotero Next 0.1.0</td><td>Windows x64</td></tr>
						<tr style="--r:1"><td>Installer</td><td>about 145 MB</td></tr>
						<tr style="--r:2"><td>Your Zotero data</td><td>read only</td></tr>
						<tr style="--r:3"><td>Released</td><td class="typed-date">7 Nov 2026</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</section>
</Site>
