---
import Site from "../layouts/Site.astro";
import { bullets, inline, mark, paragraphs, section, tables } from "../lib/readme";

const base = import.meta.env.BASE_URL;

const vsBody = section("### Zotero Next against Zotero 10");
const vs = tables(vsBody)[0];
const vsIntro = paragraphs(vsBody)[0];
const vsMethod = bullets(vsBody);
const benchIntro = paragraphs(section("## Benchmarks"))[0];

// Lower is better for every row except none; mark the better side when the two numbers are comparable.
const num = (v: string) => {
	const m = /^([\d.,]+)\s*(ms|s|MB)?/.exec(v.trim());
	if (!m) return null;
	const n = Number(m[1].replace(/,/g, ""));
	return m[2] === "s" ? n * 1000 : n;
};
const better = (row: string[]) => {
	const a = num(row[1]), b = num(row[2]);
	if (a == null || b == null || a === b) return -1;
	return a < b ? 1 : 2;
};

const ownBody = section("### Zotero Next on its own");
const own = tables(ownBody);

const gridBody = section("## Feature comparison with Zotero 10");
const grid = tables(gridBody)[0];
// the README's emoji legend is replaced by the Yes / Partly / No pills here
const gridIntro = paragraphs(gridBody).map((p) => p.replace(/^✅ yes, ⚠️ partly, ❌ no\.\s*/u, ""));
---
<Site page="compare" title="Compare with Zotero 10" description="Start-up, memory and search benchmarks against Zotero 10.0.7, and a feature-by-feature comparison.">
	<section class="page-head">
		<div class="wrap">
			<p class="eyebrow">Compare</p>
			<h1>Zotero Next and Zotero 10</h1>
			<p set:html={inline(benchIntro, base)} />
		</div>
	</section>

	<section class="section" style="padding-top: 2rem">
		<div class="wrap">
			<div class="section-head">
				<h2>Benchmarks</h2>
				<p set:html={inline(vsIntro, base)} />
			</div>
			<div class="table-scroll">
				<table class="data">
					<thead><tr>{vs.head.map((h) => <th>{h}</th>)}</tr></thead>
					<tbody>
						{vs.rows.map((r) => {
							const w = better(r);
							return (
								<tr>
									<td>{r[0]}</td>
									<td class:list={["num", { win: w === 1 }]}>{r[1]}</td>
									<td class:list={["num", { win: w === 2 }]}>{r[2]}</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
			<p class="stats-note">Bold marks the lower (better) figure. Median, with the range of three runs in brackets.</p>
			<details class="method">
				<summary>How this was measured</summary>
				<ul>{vsMethod.map((b) => <li set:html={inline(b, base)} />)}</ul>
			</details>

			{own.length > 0 && (
				<div style="margin-top: 3.5rem">
					<h3 style="font-size: 1.5rem; margin-bottom: 1rem">Zotero Next on its own</h3>
					<div class="cards">
						{own.map((t) => (
							<div class="table-scroll">
								<table class="data">
									<thead><tr>{t.head.map((h) => <th>{h}</th>)}</tr></thead>
									<tbody>{t.rows.map((r) => <tr>{r.map((c, i) => <td class:list={{ num: i > 0 }} set:html={inline(c, base)} />)}</tr>)}</tbody>
								</table>
							</div>
						))}
					</div>
					<div class="prose" style="margin-top: 1rem">
						{paragraphs(ownBody).map((p) => <p class="small" set:html={inline(p, base)} />)}
					</div>
				</div>
			)}
		</div>
	</section>

	<section class="section section-alt" id="features">
		<div class="wrap">
			<div class="section-head">
				<h2>Feature by feature</h2>
				{gridIntro.map((p) => <p set:html={inline(p, base)} />)}
			</div>
			<div class="table-scroll">
				<table class="data">
					<thead>
						<tr>
							<th>{grid.head[0]}</th>
							<th class="center">{grid.head[1]}</th>
							<th class="center">{grid.head[2]}</th>
							<th>{grid.head[3]}</th>
						</tr>
					</thead>
					<tbody>
						{grid.rows.map((r) => (
							<tr>
								<td>{r[0]}</td>
								{[r[1], r[2]].map((c) => {
									const m = mark(c);
									return <td class="center">{m ? <span class={`pill ${m.tone}`}>{m.label}</span> : c}</td>;
								})}
								<td class="note" set:html={inline(r[3] ?? "", base)} />
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>
</Site>
