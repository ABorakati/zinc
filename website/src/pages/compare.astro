---
import Icon from "../components/Icon.astro";
import Site from "../layouts/Site.astro";
import { bullets, inline, mark, paragraphs, section, tables } from "../lib/readme";

const base = import.meta.env.BASE_URL;

const vsBody = section("### Zotero Next against Zotero 10");
const vs = tables(vsBody)[0];
const vsIntro = paragraphs(vsBody)[0];
const vsMethod = bullets(vsBody);
const benchIntro = paragraphs(section("## Benchmarks"))[0];

// Lower is better in every row; mark the lower figure when the two are comparable numbers.
const num = (v: string) => {
	const m = /^([\d.,]+)\s*(ms|s|MB)?/.exec(v.trim());
	if (!m) return null;
	const n = Number(m[1].replace(/,/g, ""));
	return m[2] === "s" ? n * 1000 : n;
};
const better = (row: string[]) => {
	const a = num(row[1]), b = num(row[2]);
	if (a == null || b == null || a === b) return -1;
	return a < b ? 1 : 2;
};

// "0.49 s (0.49 to 3.30)" -> the median and its range, shown apart
const split = (v: string) => {
	const m = /^(.*?)\s*\((.+)\)$/.exec(v.trim());
	if (!m) return { v, rng: "" };
	const unit = /\s(ms|s|MB)$/.exec(m[1])?.[1];
	return { v: m[1], rng: `range ${m[2].replace(/\s+to\s+/, "–")}${unit ? " " + unit : ""}` };
};
// how much better Zotero Next is, when it is: "3.7× faster" for times, "54% less" for sizes
const gain = (row: string[]) => {
	const a = num(row[1]), b = num(row[2]);
	if (a == null || b == null || b >= a || b === 0) return "";
	if (/MB/.test(row[2])) return `${Math.round((1 - b / a) * 100)}% less`;
	if (!/\d\s*(ms|s)\b/.test(row[2])) return "";
	const x = a / b;
	return `${x >= 10 ? Math.round(x) : x.toFixed(1)}× faster`;
};

const ownBody = section("### Zotero Next on its own");
const own = tables(ownBody);
const ownParas = paragraphs(ownBody);

const gridBody = section("## Feature comparison with Zotero 10");
const grid = tables(gridBody)[0];
// the README's emoji legend is replaced by the stamps here
const gridIntro = paragraphs(gridBody).map((p) => p.replace(/^✅ yes, ⚠️ partly, ❌ no\.\s*/u, ""));
---
<Site page="compare" title="Compare with Zotero 10" description="Start-up, memory and search benchmarks against Zotero 10.0.7, and a feature-by-feature comparison.">
	<section class="hero" style="padding-bottom: 2rem">
		<div class="wrap">
			<h1 class="display" style="margin-bottom: 1.5rem">Zotero Next and Zotero 10, side by side</h1>
			<p class="lede" set:html={inline(benchIntro, base)} />
		</div>
	</section>

	<section class="room-tight">
		<div class="wrap">
			<div class="head">
				<h2 class="h2">The speed register</h2>
				<p set:html={inline(vsIntro, base)} />
			</div>
			<div class="register stack" data-reveal>
				<table>
					<thead><tr>{vs.head.map((h, j) => <th class:list={{ ours: j === 2 }}>{h}</th>)}</tr></thead>
					<tbody>
						{vs.rows.map((r, i) => {
							const w = better(r);
							const a = split(r[1]), b = split(r[2]), g = gain(r);
							return (
								<tr style={`--r:${i}`}>
									<td>{r[0]}</td>
									<td class:list={["num", { better: w === 1 }]} data-label={vs.head[1]}><span class="v">{a.v}</span>{a.rng && <span class="rng">{a.rng}</span>}</td>
									<td class:list={["num", "ours", { better: w === 2 }]} data-label={vs.head[2]}><span class="v">{b.v}</span>{g && <span class="gain">{g}</span>}{b.rng && <span class="rng">{b.rng}</span>}</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
			<p class="register-caption">Lower is better in every row. Each figure is the median of three runs, with their range underneath; the green note shows how far ahead Zotero Next is where it leads.</p>

			<details class="method" style="margin-top: 2rem">
				<summary class="h3" style="font-size: 1.15rem; cursor: pointer">How this was measured</summary>
				<ul class="points" style="margin-top: 1rem; max-width: 52rem">{vsMethod.map((b) => <li set:html={inline(b, base)} />)}</ul>
			</details>

			{own.length > 0 && (
				<div style="margin-top: 4rem">
					<h2 class="h3" style="margin-bottom: 0.75rem">Zotero Next on its own</h2>
					{ownParas[0] && <p style="margin-bottom: 1.25rem; color: var(--ink-2)" set:html={inline(ownParas[0], base)} />}
					<div class:list={{ pair: own.length > 1 }} style={own.length > 1 ? undefined : "max-width: 40rem"}>
						{own.map((t) => (
							<div class="register" data-reveal>
								<table>
									<thead><tr>{t.head.map((h) => <th>{h}</th>)}</tr></thead>
									<tbody>{t.rows.map((r, i) => <tr style={`--r:${i}`}>{r.map((c, j) => <td class:list={{ num: j > 0 }} set:html={inline(c, base)} />)}</tr>)}</tbody>
								</table>
							</div>
						))}
					</div>
					<div class="prose" style="margin-top: 1.25rem; max-width: 52rem">
						{ownParas.slice(1).map((p) => <p style="font-size: 0.95rem" set:html={inline(p, base)} />)}
					</div>
				</div>
			)}
		</div>
	</section>

	<section class="room" id="features" style="background: var(--ground-2); margin-top: clamp(3rem, 7vw, 6rem)">
		<div class="wrap">
			<div class="head">
				<h2 class="h2">The feature register</h2>
				{gridIntro.map((p) => <p set:html={inline(p, base)} />)}
			</div>
			<div class="register" data-reveal>
				<table>
					<thead>
						<tr>
							<th>{grid.head[0]}</th>
							<th class="center">{grid.head[1]}</th>
							<th class="center">{grid.head[2]}</th>
							<th>{grid.head[3]}</th>
						</tr>
					</thead>
					<tbody>
						{grid.rows.map((r, i) => (
							<tr style={`--r:${i}`}>
								<td>{r[0]}</td>
								{[r[1], r[2]].map((c) => {
									const m = mark(c);
									const icon = m && { yes: "check", part: "circle-dashed", no: "x", na: "minus" }[m.tone];
									return <td class="center">{m ? <span class={`stamp ${m.tone}`}>{icon && <Icon name={icon} size={12} />}{m.label}</span> : c}</td>;
								})}
								<td class="note" set:html={inline(r[3] ?? "", base)} />
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>
</Site>
