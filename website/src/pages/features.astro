---
import Icon from "../components/Icon.astro";
import Plate from "../components/Plate.astro";
import Site from "../layouts/Site.astro";
import { bullets, inline, paragraphs, section, subsections } from "../lib/readme";
import { slug } from "../lib/shelf";

const base = import.meta.env.BASE_URL;

// One row per README "## Features" group, then the Word add-in and MCP, each beside its screenshot. A group without a screenshot
// yet shows its list across the full width.
interface Shot { src: string; dark?: string; h?: number; n: string; alt: string; caption: string }
const SHOTS: Record<string, Shot> = {
	library: { src: "library-cards-light.png", dark: "library-cards-dark.png", n: "I", alt: "The library in Cards view: coloured collections, papers grouped by year, and the item pane", caption: "The library in Cards view." },
	"pdf-reader": { src: "pdf-reader-annotations-light.png", dark: "pdf-reader-annotations-dark.png", h: 881, n: "III", alt: "The PDF reader with highlights and the annotations panel", caption: "The PDF reader with the annotations panel." },
	"notes-and-web": { src: "reading-view-table.png", n: "IV", alt: "The reading view, showing an article's table as a card", caption: "The reading view, with a table set as a card." },
	"around-the-app": { src: "settings-reader-dark.png", n: "V", alt: "Settings, on the reader page, in the dark theme", caption: "Settings, reader page, dark theme." },
	"word-add-in": { src: "word-sidebar.png", h: 839, n: "VII", alt: "Word with the Zotero Next sidebar beside a paragraph with numbered citations and a bibliography", caption: "The Word sidebar, with the app closed." },
};
const ICONS: Record<string, string> = { library: "library", "pdf-reader": "file-text", "notes-and-web": "notebook-pen", "sync-and-storage": "refresh-cw", "getting-references-in-and-out": "arrow-left-right", "better-bibtex": "braces", "zotmoov-file-storage": "folder-tree", "around-the-app": "settings", "word-add-in": "panel-right", "mcp-for-agents": "bot" };
const MORE: Record<string, string> = { "pdf-reader": "user-guide/reader/", "better-bibtex": "user-guide/better-bibtex/", "zotmoov-file-storage": "user-guide/zotmoov-storage/", "sync-and-storage": "user-guide/sync/" };
// a group's own lead line, if the README has one before its bullets ("Built in, no plugin to install:")
const leadOf = (body: string) => body.split(/\n\s*\n/).map((p) => p.trim()).find((p) => p && !p.startsWith("-") && !p.startsWith("|")) ?? "";

const groups = [
	...subsections(section("## Features")).map((s) => ({ title: s.title, id: slug(s.title), lead: leadOf(s.body), items: bullets(s.body), more: MORE[slug(s.title)] ? `${base}${MORE[slug(s.title)]}` : "" })),
	{ title: "Word add-in", id: "word-add-in", lead: "", items: [paragraphs(section("## The Word add-in"))[0]], more: `${base}user-guide/word/` },
	{ title: "MCP for agents", id: "mcp-for-agents", lead: "", items: [paragraphs(section("### Built-in MCP for AI agents"))[0]], more: `${base}user-guide/mcp/` },
].map((g) => ({ ...g, shot: SHOTS[g.id], icon: ICONS[g.id] ?? "circle" }));
---
<Site page="features" title="Features" description="Everything Zotero Next does: library, PDF reader, notes, sync, translators, Better BibTeX, the Word add-in, the browser connector and MCP.">
	<section class="hero">
		<div class="wrap">
			<div class="head">
				<h1 class="display" style="margin-bottom: 1rem">Everything it does</h1>
				<p>Every part of Zotero Next. What Zotero has that Zotero Next does not is in the <a href={`${base}compare/#features`}>comparison</a>.</p>
			</div>
			<nav class="feature-index" aria-label="Jump to a feature">
				{groups.map((g) => <a href={`#${g.id}`}><Icon name={g.icon} size={16} />{g.title}</a>)}
			</nav>
		</div>
	</section>

	<section class="room" style="padding-top: 0">
		<div class="wrap">
			{groups.map((g, i) => (
				<article class:list={["volume", "feature-row", { flip: i % 2 === 1, "no-shot": !g.shot }]} id={g.id}>
					<div>
						<h2 class="h2"><Icon name={g.icon} size={26} />{g.title}</h2>
						{g.lead && <p class="feature-lead" set:html={inline(g.lead, base)} />}
						<ul class="points">{g.items.map((it) => <li set:html={inline(it, base)} />)}</ul>
						{g.more && <p class="feature-more"><a href={g.more}>Read the guide</a></p>}
					</div>
					{g.shot && <Plate n={g.shot.n} src={g.shot.src} dark={g.shot.dark} h={g.shot.h ?? 857} tilt={i % 2 ? 0.6 : -0.6} alt={g.shot.alt} caption={g.shot.caption} />}
				</article>
			))}
		</div>
	</section>
</Site>
