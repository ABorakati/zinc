---
import Plate from "../components/Plate.astro";
import Shelf from "../components/Shelf.astro";
import Site from "../layouts/Site.astro";
import { bullets, inline, section, subsections } from "../lib/readme";
import { slug, volumes } from "../lib/shelf";

const base = import.meta.env.BASE_URL;
const vols = volumes(base);
const groups = subsections(section("## Features")).map((s, i) => ({ title: s.title, id: slug(s.title), items: bullets(s.body), cloth: vols[i]?.cloth ?? "green", call: vols[i]?.call ?? "" }));

// Screenshots and captions from the README's screenshot table (image row, then caption row).
const rows = section("## Screenshots").split("\n").filter((l) => l.trim().startsWith("|") && !/^\|\s*(---|\|)/.test(l.trim()));
const gallery: { file: string; alt: string; caption: string }[] = [];
for (let i = 0; i + 1 < rows.length; i++) {
	const imgs = [...rows[i].matchAll(/!\[([^\]]*)\]\(docs\/screenshots\/([^)]+)\)/g)];
	if (!imgs.length) continue;
	const caps = rows[i + 1].split("|").map((c) => c.trim()).filter(Boolean);
	imgs.forEach((m, j) => gallery.push({ file: m[2], alt: m[1], caption: caps[j] ?? m[1] }));
	i++;
}
const tall = (f: string) => f.startsWith("pdf-reader");
// one number per screenshot across the site (the home page uses I to IV): I cards, II classic table, III reader, IV reading view,
// V settings, VI the reader with its dark page tint
const PLATE: Record<string, string> = { "library-cards": "I", "classic-table": "II", "pdf-reader-annotations": "III", "pdf-reader-annotations-dark": "VI", "reading-view-table": "IV", "settings-reader": "V" };
const plateNo = (f: string) => { const k = f.replace(/\.png$/, ""); return PLATE[k] ?? PLATE[k.replace(/-(light|dark)$/, "")] ?? "–"; };
---
<Site page="features" title="Features" description="Everything Zotero Next does: library, PDF reader, notes, sync, translators, Better BibTeX, the Word add-in, the browser connector and MCP.">
	<section class="cloth shelf-room">
		<div class="wrap">
			<div class="head">
				<h1 class="display" style="margin-bottom: 1rem">The collection</h1>
				<p>Every part of Zotero Next, one volume each. What Zotero has that Zotero Next does not is in the <a href={`${base}compare/#features`}>comparison register</a>.</p>
			</div>
			<Shelf label="Jump to a volume" />
		</div>
	</section>

	<section class="room">
		<div class="wrap">
			{groups.map((g) => (
				<article class="vol-page" id={g.id}>
					<div class={`vol-spine c-${g.cloth}`} aria-hidden="true">
						<span class="spine-band"></span>
						<span class="spine-title">{g.title}</span>
						<span class="spine-label">{g.call}</span>
					</div>
					<div class="vol-body">
						<h2 class="h3">{g.title}</h2>
						<ul>{g.items.map((it) => <li set:html={inline(it, base)} />)}</ul>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="room" style="background: var(--ground-2); padding-top: clamp(4rem, 9vw, 7.5rem)">
		<div class="wrap">
			<div class="head">
				<h2 class="h2">Plates</h2>
				<p>Screenshots of the app, taken on a demo library of well-known public papers.</p>
			</div>
			<div class="plates">
				{gallery.map((g, i) => (
					<Plate n={plateNo(g.file)} src={g.file} alt={g.alt} caption={g.caption} h={tall(g.file) ? 881 : 857} tilt={i % 2 ? 0.7 : -0.7} />
				))}
			</div>
		</div>
	</section>
</Site>
