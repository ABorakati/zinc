---
// One picture for the "Works with the app closed" slideshow: the Word sidebar screenshot, how a browser save reaches the library
// (a diagram, not a screenshot), or the MCP calls an agent made through the Word add-in in the demo document (real calls and results,
// the ones that built the Word screenshot).
import Icon from "./Icon.astro";
interface Props { id: "word" | "browser" | "agent" }
const { id } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{id === "word" && (
	<figure class="slide-shot">
		<img src={`${base}screenshots/word-sidebar.png`} width="1400" height="839" loading="lazy"
			alt="Word with the Zotero Next sidebar beside a paragraph with six numbered citations and a Vancouver bibliography; the sidebar shows the citation under the cursor" />
		<figcaption>The Word sidebar showing the citation under the cursor. Zotero Next is not running.</figcaption>
	</figure>
)}
{id === "browser" && (
	<figure class="slide-flow">
		<ol>
			<li><Icon name="globe" size={22} /><strong>A page in Chrome or Edge</strong><span>an article, a PDF, a search result</span></li>
			<li><Icon name="puzzle" size={22} /><strong>Zotero Next Connector</strong><span>click Save in the toolbar</span></li>
			<li><Icon name="terminal" size={22} /><strong>zotero-next-host.exe</strong><span>a small helper the browser starts</span></li>
			<li><Icon name="database" size={22} /><strong>Your library</strong><span>the item, its PDF and its collection</span></li>
		</ol>
		<p class="slide-off"><Icon name="power-off" size={14} />Zotero Next stays closed</p>
		<figcaption>How a save reaches your library without the app.</figcaption>
	</figure>
)}
{id === "agent" && (
	<figure class="slide-term">
		<div class="term" role="img" aria-label="Three MCP tool calls to the Word add-in and their results">
			<div class="term-bar"><span></span><span></span><span></span><em>MCP · Word add-in · 127.0.0.1:23125</em></div>
			<pre><span class="t-call">search_library</span> <span class="t-arg">{`{ "query": "Gulshan" }`}</span>
<span class="t-out">→ 5YM8PXR3  Development and Validation of a Deep Learning
  Algorithm for Detection of Diabetic Retinopathy… (JAMA, 2016)</span>

<span class="t-call">insert_citation</span> <span class="t-arg">{`{ "items": [{ "key": "5YM8PXR3" }],
  "position": { "afterText": "grading diabetic retinopathy" } }`}</span>
<span class="t-out">→ inserted citation 2: "(2)"</span>

<span class="t-call">insert_bibliography</span> <span class="t-arg">{`{ "position": "end" }`}</span>
<span class="t-out">→ created: 1. LeCun Y, Bengio Y, Hinton G. Deep learning…</span></pre>
		</div>
		<figcaption>Real calls an agent made through the Word add-in's MCP server to build the demo document, results shortened.</figcaption>
	</figure>
)}
