---
// The site's top bar: brand, the main links (Demo last), GitHub, light/dark and Download. The product pages (layouts/Site.astro)
// and the docs (components/DocsHeader.astro, Starlight's Header override) both use it; the docs put their search box in the
// `search` slot. Styles: styles/masthead.css, scoped to .zn-head so they carry their own colours into the docs.
import Icon from "./Icon.astro";
import "../styles/masthead.css";

interface Props { page?: "home" | "features" | "compare" | "docs" | "demo" | "download"; docs?: boolean }
const { page, docs = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
	{ id: "features", label: "Features", href: `${base}features/` },
	{ id: "compare", label: "Compare", href: `${base}compare/` },
	{ id: "docs", label: "Docs", href: `${base}overview/` },
	{ id: "demo", label: "Demo", href: `${base}demo/` },
];
---
<div class:list={["zn-head", "masthead-row", { "is-docs": docs }]}>
	<a class="brand" href={base} aria-label="Zinc home">
		<img src={`${base}icon.svg`} alt="" width="30" height="30" />
		<span class="brand-name">Zinc</span>
	</a>
	<nav class="masthead-nav" aria-label="Main">
		{nav.map((n) => <a href={n.href} aria-current={page === n.id ? "page" : undefined}>{n.label}</a>)}
	</nav>
	<div class="masthead-search"><slot name="search" /></div>
	<a class="btn btn-ghost btn-sm masthead-github" href="https://github.com/ABorakati/zinc" aria-label="Zinc on GitHub">
		<svg class="icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
		<span class="masthead-github-label">GitHub</span>
	</a>
	<button class="btn btn-ghost btn-icon theme" type="button" aria-label="Switch between light and dark" data-zn-theme>
		<Icon name="sun" class="i-sun" />
		<Icon name="moon" class="i-moon" />
	</button>
	<a class="btn btn-primary btn-sm masthead-download" href={`${base}download/`} aria-current={page === "download" ? "page" : undefined}><Icon name="download" size={14} />Download</a>
</div>

<script is:inline>
	// light/dark: the same localStorage key as Starlight's own theme picker, so the docs and the product pages agree
	(() => {
		for (const b of document.querySelectorAll("[data-zn-theme]")) {
			if (b.dataset.bound) continue;
			b.dataset.bound = "1";
			b.addEventListener("click", () => {
				const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
				document.documentElement.dataset.theme = next;
				try { localStorage.setItem("starlight-theme", next); } catch {}
			});
		}
	})();
</script>
