---
// The home page's hero: app screenshots that cross-fade one to the next, with no hotspots. Each slide may have a dark-theme
// screenshot that replaces it when the site is dark. It advances every few seconds, pauses while the pointer or focus is on it
// or the tab is hidden, and does not advance at all for people who ask for reduced motion (the dots still switch slides).
interface Slide { src: string; dark?: string; alt: string; caption: string }
const slides: Slide[] = [
	{ src: "library-cards-light.png", dark: "library-cards-dark.png", caption: "The library in Cards view, with coloured and pinned collections.",
		alt: "The library in Cards view: coloured collections on the left, papers grouped by year in the middle, the selected paper's details on the right" },
	{ src: "pdf-reader-annotations-light.png", dark: "pdf-reader-annotations-dark.png", caption: "The PDF reader, with highlights and notes.",
		alt: "A paper open in the PDF reader, with highlights and the annotations sidebar" },
	{ src: "reading-view-table.png", caption: "Reading view: the paper reflowed into one column, in your own font.",
		alt: "A paper reflowed into a single column in reading view, with a table" },
	{ src: "classic-table-dark.png", caption: "The Classic table, sortable by any column.",
		alt: "The library as a sortable table in dark mode" },
	{ src: "word-sidebar.png", caption: "Cite from a sidebar in Word, even with the app closed.",
		alt: "The Zinc sidebar in Word, searching the library to insert a citation" },
];
const base = import.meta.env.BASE_URL;
const url = (f: string) => `${base}screenshots/${f}`;
---
<figure class="hero-show" data-hero-show aria-roledescription="carousel" aria-label="Screenshots of Zinc">
	<div class="hs-view">
		{slides.map((s, i) => (
			<div class:list={["hs-slide", { "is-on": i === 0 }]} data-slide={i} aria-hidden={i === 0 ? undefined : "true"}>
				<img class:list={[{ "only-light": !!s.dark }]} src={url(s.src)} alt={s.alt} width="1400" height="857"
					loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} />
				{s.dark && <img class="only-dark" src={url(s.dark)} alt={s.alt} width="1400" height="857" loading="lazy" />}
			</div>
		))}
	</div>
	<figcaption class="hs-foot">
		<span class="hs-caption" aria-live="polite" data-caption>{slides[0].caption}</span>
		<span class="hs-dots">
			{slides.map((s, i) => (
				<button type="button" class:list={["hs-dot", { "is-on": i === 0 }]} data-go={i} data-caption-text={s.caption}
					aria-label={`Show screenshot ${i + 1} of ${slides.length}`} aria-current={i === 0 ? "true" : undefined}></button>
			))}
		</span>
	</figcaption>
</figure>

<style>
	.hero-show { margin: 0; }
	.hs-view { position: relative; aspect-ratio: 1400 / 857; overflow: hidden; border-radius: 10px; border: 1px solid var(--rule); box-shadow: var(--shadow-card); background: var(--card); }
	.hs-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s var(--ease); }
	.hs-slide.is-on { opacity: 1; }
	.hs-slide img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
	.hs-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.9rem; }
	.hs-caption { font: 400 0.92rem/1.45 var(--f-text); color: var(--ink-3); min-height: 2.9em; }
	.hs-dots { display: flex; gap: 0.15rem; flex: none; }
	/* a 24 px hit area around a small dot */
	.hs-dot { width: 1.5rem; height: 1.5rem; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; border-radius: 999px; }
	.hs-dot::after { content: ""; width: 0.45rem; height: 0.45rem; border-radius: 999px; background: var(--rule); transition: background-color 0.2s, width 0.3s var(--ease); }
	.hs-dot:hover::after { background: var(--ink-3); }
	.hs-dot.is-on::after { width: 1.1rem; background: var(--primary); }
	.hs-dot:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }
	@media (prefers-reduced-motion: reduce) { .hs-slide, .hs-dot::after { transition: none; } }
</style>

<script>
	const DWELL = 4800;
	for (const show of document.querySelectorAll<HTMLElement>("[data-hero-show]")) {
		const slides = [...show.querySelectorAll<HTMLElement>(".hs-slide")];
		const dots = [...show.querySelectorAll<HTMLButtonElement>(".hs-dot")];
		const caption = show.querySelector<HTMLElement>("[data-caption]")!;
		const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
		let at = 0, paused = false, timer = 0;
		const go = (i: number) => {
			at = (i + slides.length) % slides.length;
			slides.forEach((s, j) => { s.classList.toggle("is-on", j === at); if (j === at) s.removeAttribute("aria-hidden"); else s.setAttribute("aria-hidden", "true"); });
			dots.forEach((d, j) => { d.classList.toggle("is-on", j === at); if (j === at) d.setAttribute("aria-current", "true"); else d.removeAttribute("aria-current"); });
			caption.textContent = dots[at]?.dataset.captionText ?? "";
			// the next slide's images start loading now, so it is ready when it fades in
			slides[(at + 1) % slides.length]?.querySelectorAll("img").forEach((img) => (img.loading = "eager"));
		};
		const tick = () => { if (!paused && !document.hidden) go(at + 1); };
		const start = () => { if (!still) { clearInterval(timer); timer = window.setInterval(tick, DWELL); } };
		dots.forEach((d) => d.addEventListener("click", () => { go(Number(d.dataset.go)); start(); }));
		show.addEventListener("pointerenter", () => (paused = true));
		show.addEventListener("pointerleave", () => (paused = false));
		show.addEventListener("focusin", () => (paused = true));
		show.addEventListener("focusout", () => (paused = false));
		start();
	}
</script>
