---
// Layout of the product pages (home, features, compare, download), in the app's own look: Inter (the app's UI font,
// gpui-ui/assets/fonts), Lucide icons, the app's buttons and segmented toggle. The docs keep Starlight's layout; both share
// the theme choice through Starlight's localStorage key.
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/manrope/wght.css";
import Icon from "../components/Icon.astro";
import "../styles/site.css";

interface Props { title?: string; description?: string; page?: "home" | "features" | "demo" | "compare" | "download" }
const { title, description = "A fast, native reference manager for Windows that works with your Zotero library.", page } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
	{ id: "features", label: "Features", href: `${base}features/` },
	{ id: "demo", label: "Try it", href: `${base}demo/` },
	{ id: "compare", label: "Compare", href: `${base}compare/` },
	{ id: "docs", label: "Docs", href: `${base}overview/` },
];
const fullTitle = title ? `${title} · Zotero Next` : "Zotero Next: your Zotero library, at native speed";
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{fullTitle}</title>
	<meta name="description" content={description} />
	<link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
	<script is:inline>
		(() => {
			let t = "";
			try { t = localStorage.getItem("starlight-theme") || ""; } catch {}
			const dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
			const root = document.documentElement;
			root.dataset.theme = dark ? "dark" : "light";
			// entrance motion only with JS and without a reduced-motion preference; content is visible otherwise
			if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("motion");
		})();
	</script>
</head>
<body>
	<a class="skip" href="#main">Skip to content</a>
	<header class="masthead">
		<div class="wrap masthead-row">
			<a class="brand" href={base} aria-label="Zotero Next home">
				<img src={`${base}icon.svg`} alt="" width="30" height="30" />
				<span class="brand-name">Zotero Next</span>
			</a>
			<nav class="masthead-nav" aria-label="Main">
				{nav.map((n) => <a href={n.href} aria-current={page === n.id ? "page" : undefined}>{n.label}</a>)}
			</nav>
			<a class="btn btn-ghost btn-sm masthead-github" href="https://github.com/ABorakati/zotero-next" aria-label="Zotero Next on GitHub">
				<svg class="icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
				<span class="masthead-github-label">GitHub</span>
			</a>
			<button class="btn btn-ghost btn-icon theme" type="button" aria-label="Switch between light and dark">
				<Icon name="sun" class="i-sun" />
				<Icon name="moon" class="i-moon" />
			</button>
			<a class="btn btn-primary btn-sm masthead-download" href={`${base}download/`} aria-current={page === "download" ? "page" : undefined}><Icon name="download" size={14} />Download</a>
		</div>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="colophon">
		<div class="wrap colophon-grid">
			<div class="colophon-about">
				<a class="brand" href={base}><img src={`${base}icon.svg`} alt="" width="24" height="24" /><span class="brand-name">Zotero Next</span></a>
				<p>A Zotero-compatible reference manager for Windows. Not affiliated with the Zotero project; Zotero is a trademark of the Corporation for Digital Scholarship.</p>
				<p class="credits">Proudly coded with vibes and Claude. Thanks to <a href="https://www.zotero.org">Zotero</a>, <a href="https://bun.sh">Bun</a>, <a href="https://www.gpui.rs">GPUI</a>, <a href="https://github.com/remorses/gpuix">GPUIX</a> and <a href="https://www.solidjs.com">Solid</a>, and to Mendeley and Papers for the inspiration.</p>
			</div>
			<div>
				<h2>Product</h2>
				<a href={`${base}features/`}>Features</a>
				<a href={`${base}compare/`}>Compare with Zotero</a>
				<a href={`${base}download/`}>Download</a>
			</div>
			<div>
				<h2>Docs</h2>
				<a href={`${base}user-guide/`}>User guide</a>
				<a href={`${base}developer-guide/`}>Developer guide</a>
				<a href={`${base}user-guide/troubleshooting/`}>Troubleshooting</a>
			</div>
			<div>
				<h2>Project</h2>
				<a href="https://github.com/ABorakati/zotero-next">Source on GitHub</a>
				<a href="https://github.com/ABorakati/zotero-next/releases">Releases</a>
				<a href={`${base}developer-guide/contributing/`}>Contributing</a>
			</div>
		</div>
	</footer>

	<script is:inline>
		(() => {
			document.querySelector(".theme")?.addEventListener("click", () => {
				const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
				document.documentElement.dataset.theme = next;
				try { localStorage.setItem("starlight-theme", next); } catch {}
			});
			if (!document.documentElement.classList.contains("motion")) return;
			const io = new IntersectionObserver((entries) => {
				for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
			}, { rootMargin: "0px 0px -12% 0px", threshold: 0 }); // 0: a block taller than the screen still reveals
			document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
		})();
	</script>
</body>
</html>
