---
// Layout of the product pages (home, features, compare, download), in the app's own look: Inter (the app's UI font,
// gpui-ui/assets/fonts), Lucide icons, the app's buttons and segmented toggle. The docs keep Starlight's layout; both share
// the theme choice through Starlight's localStorage key.
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/manrope/wght.css";
import Masthead from "../components/Masthead.astro";
import "../styles/site.css";

interface Props { title?: string; description?: string; page?: "home" | "features" | "demo" | "compare" | "download" }
const { title, description = "A fast, native reference manager for Windows that works with your Zotero library.", page } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} · Zinc` : "Zinc: your Zotero library, at native speed";
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{fullTitle}</title>
	<meta name="description" content={description} />
	<link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
	<script is:inline>
		(() => {
			let t = "";
			try { t = localStorage.getItem("starlight-theme") || ""; } catch {}
			const dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
			const root = document.documentElement;
			root.dataset.theme = dark ? "dark" : "light";
			// entrance motion only with JS and without a reduced-motion preference; content is visible otherwise
			if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("motion");
		})();
	</script>
</head>
<body>
	<a class="skip" href="#main">Skip to content</a>
	<header class="masthead">
		<div class="wrap"><Masthead page={page} /></div>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="colophon">
		<div class="wrap colophon-grid">
			<div class="colophon-about">
				<a class="brand" href={base}><img src={`${base}icon.svg`} alt="" width="24" height="24" /><span class="brand-name">Zinc</span></a>
				<p>A Zotero-compatible reference manager for Windows. Not affiliated with the Zotero project; Zotero is a trademark of the Corporation for Digital Scholarship.</p>
				<p class="credits">Proudly coded with vibes and Claude. Thanks to <a href="https://www.zotero.org">Zotero</a>, <a href="https://bun.sh">Bun</a>, <a href="https://www.gpui.rs">GPUI</a>, <a href="https://github.com/remorses/gpuix">GPUIX</a> and <a href="https://www.solidjs.com">Solid</a>, and to Mendeley and Papers for the inspiration.</p>
			</div>
			<div>
				<h2>Product</h2>
				<a href={`${base}features/`}>Features</a>
				<a href={`${base}compare/`}>Compare with Zotero</a>
				<a href={`${base}download/`}>Download</a>
			</div>
			<div>
				<h2>Docs</h2>
				<a href={`${base}user-guide/`}>User guide</a>
				<a href={`${base}developer-guide/`}>Developer guide</a>
				<a href={`${base}user-guide/troubleshooting/`}>Troubleshooting</a>
				<a href={`${base}llms.txt`} title="The docs as Markdown, for language models (llmstxt.org)">llms.txt</a>
			</div>
			<div>
				<h2>Project</h2>
				<a href="https://github.com/ABorakati/zinc">Source on GitHub</a>
				<a href="https://github.com/ABorakati/zinc/releases">Releases</a>
				<a href={`${base}developer-guide/contributing/`}>Contributing</a>
			</div>
		</div>
	</footer>

	<script is:inline>
		(() => {
			// (the light/dark button is wired by components/Masthead.astro)
			if (!document.documentElement.classList.contains("motion")) return;
			const io = new IntersectionObserver((entries) => {
				for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
			}, { rootMargin: "0px 0px -12% 0px", threshold: 0 }); // 0: a block taller than the screen still reveals
			document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
		})();
	</script>
</body>
</html>
