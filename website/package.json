{
  "name": "zotero-next-docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-assets.ts",
    "dev": "bun run sync && bun --bun astro dev",
    "build": "bun run sync && bun --bun astro build",
    "preview": "bun --bun astro preview",
    "docs:dev": "bun run dev",
    "docs:build": "bun run build",
    "docs:preview": "bun run build && bun --bun astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.3.6",
    "astro-mermaid": "^2.2.0",
    "mermaid": "^12.3.0",
    "sharp": "^0.35.3"
  }
}
