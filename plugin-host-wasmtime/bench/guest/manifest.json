{
	"manifest_version": 1,
	"id": "bench-guest@zinc.test",
	"name": "Bench and protocol fixture (Rust)",
	"version": "0.1.0",
	"zinc": { "api_version": "0.1" },
	"main": { "wasm": "plugin.wasm", "world": "plugin-minimal", "language": "rust" },
	"locales": { "default": "en-US", "available": ["en-US", "fr"], "dir": "locale" },
	"permissions": {
		"capabilities": ["library.read", "library.write", "library.files.read", "library.files.write"]
	},
	"default_prefs": {
		"greeting": "hello",
		"count": 42,
		"enabled": true
	}
}
