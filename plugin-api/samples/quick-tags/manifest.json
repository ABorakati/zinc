{
	"manifest_version": 1,
	"id": "quick-tags@zinc.example",
	"name": "Quick Tags",
	"version": "0.1.0",
	"author": "Zinc samples",
	"license": "MIT",
	"zinc": { "api_version": "0.1" },
	"main": { "wasm": "plugin.wasm", "world": "plugin", "language": "js" },
	"activation_events": ["onStartup"],
	"permissions": { "capabilities": ["library.read", "library.write"] },
	"permission_reasons": { "library.write": "Add the tags you type to the selected items." }
}
