{
	"manifest_version": 1,
	"id": "word-count@zinc.example",
	"name": "Word Count",
	"version": "0.1.0",
	"description_l10n": "plugin-description",
	"author": "Zinc samples",
	"license": "MIT",
	"zinc": { "api_version": "0.1" },
	"main": { "wasm": "plugin.wasm", "world": "plugin", "language": "rust" },
	"activation_events": ["onStartup"],
	"permissions": { "capabilities": ["library.read", "library.fulltext.read"] },
	"permission_reasons": {
		"library.read": "Find the PDF of each item to count its words.",
		"library.fulltext.read": "Read the indexed text of the PDF."
	},
	"default_prefs": { "countNumbers": false }
}
