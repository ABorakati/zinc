# Upstream Zotero repos, cloned and built by scripts/build-docworker.sh, reader-host/build.sh and note-host/build.sh
vendor/
# ...except native/pdf/vendor: the PDFium fetch script and PDFium's licence files are committed (the fetched library itself is
# ignored by gpui-ui/native/pdf/.gitignore)
!gpui-ui/native/pdf/vendor/

node_modules/
dist/
dist-*/

# Local library database (imported from Zotero)
data/
# ...except the Zotero compatibility tests' upstream fixture
!core/test/zotero-compat/data/

# Agent verification screenshots (mock data)
note-host/*.png

# Build logs
*.log

# Docs site (website/): dependencies, build output, generated copy of docs/screenshots
website/node_modules/
website/dist/
website/.astro/
website/public/screenshots/

# impeccable design-skill scratch: review screenshots and decision-page state
.impeccable/review/
.impeccable/questions/
website/public/word-demo/
website/public/app-demo/
