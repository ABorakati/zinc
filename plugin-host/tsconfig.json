{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"allowImportingTsExtensions": true
	},
	"include": ["src", "scripts", "test/*.ts", "test/handlers", "test/pkg"]
}
