{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun", "vite/client"],
		"allowImportingTsExtensions": true,
		"paths": { "~/*": ["./src/*"] }
	},
	"include": ["src", "mock-api.ts", "vite.config.ts"]
}
