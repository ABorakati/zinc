    "prebuild": "bun -e \"await Bun.write('public/pdfium.wasm', Bun.file('node_modules/@embedpdf/pdfium/dist/pdfium.wasm'))\"",
    "build": "bun --bun x vite build",
    "dev": "bun --bun x vite",
    "check": "bun check"
  },
